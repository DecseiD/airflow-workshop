# DAG Git source
GIT_SYNC_REPO=https://github.com/<org>/<dag-repo>.git
GIT_SYNC_BRANCH=main
GIT_SYNC_REV=HEAD

# Polling interval (seconds)
GIT_SYNC_PERIOD=30s

# Folder inside repo that contains DAG files
GIT_SYNC_SUBPATH=dags

# Auth options (use one approach)
# GIT_SYNC_USERNAME=
# GIT_SYNC_PASSWORD=
# GIT_SSH_KEY_FILE=/etc/git-secret/ssh
