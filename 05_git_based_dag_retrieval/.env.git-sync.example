# DAG Git source (git-sync v4 style keys)
GITSYNC_REPO=https://github.com/<org>/<dag-repo>.git
GITSYNC_REF=main

# Polling interval
GITSYNC_PERIOD=30s

# Optional auth for private HTTPS repo
# GITSYNC_USERNAME=
# GITSYNC_PASSWORD=

# Optional auth for private SSH repo
# GITSYNC_SSH_KEY_FILE=/etc/git-secret/ssh
